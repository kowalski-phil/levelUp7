# Supabase: Settings > API Keys (Publishable key, Secret key). Die gleichen drei Werte kommen in Vercel unter Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Nur für npm run seed (lokal, nicht in Vercel)
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_NAME=Paula
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
SEED_PARENT_NAME=Phil

# Web-Push-Erinnerungen: VAPID-Schlüssel (npx web-push generate-vapid-keys) und Cron-Schutz. Auch in Vercel eintragen.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
